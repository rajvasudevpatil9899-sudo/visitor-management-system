# Administrator-only email configuration.
# Copy this file to .env and fill in your college/system Gmail details.
# Never share .env or upload it to GitHub.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-college-email@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
MAIL_FROM=your-college-email@gmail.com
SMTP_USE_SSL=false

# Replace this with a long, random value before deployment.
SECRET_KEY=replace-this-with-a-long-random-secret-key
